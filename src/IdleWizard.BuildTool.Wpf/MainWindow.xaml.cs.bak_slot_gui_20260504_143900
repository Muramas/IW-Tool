public sealed class EquipmentCard
{
    public string Slot { get; set; } = "";
    public string ItemId { get; set; } = "";
    public string Tier { get; set; } = "";

    public string ItemDisplay { get; set; } = "";
    public string TierDisplay { get; set; } = "";
    public string EnchantDisplay { get; set; } = "";

    public string Verdict { get; set; } = "";
    public string VerdictBrush { get; set; } = "#CCCCCC";

    public string ScoreDisplay { get; set; } = "";
    public string Notes { get; set; } = "";

    public System.Windows.Visibility HasScoreVisibility =>
        string.IsNullOrWhiteSpace(ScoreDisplay)
            ? System.Windows.Visibility.Collapsed
            : System.Windows.Visibility.Visible;

    // Slot-centric recommendation fields.
    // These make the UI display recommendations as first-class data instead of guessing from Notes/ScoreDisplay.
    public string SuggestedItemDisplay { get; set; } = "Run Analyze to get a suggestion.";
    public string SuggestedRankDisplay { get; set; } = "";
    public string SuggestedGainDisplay { get; set; } = "";
    public string SuggestedReason { get; set; } = "No recommendation has been calculated for this slot yet.";
    public string SuggestedStatus { get; set; } = "Pending";
    public string SuggestedStatusBrush { get; set; } = "#CCCCCC";

    public string CurrentEnchantContext
    {
        get
        {
            var parts = new List<string>();

            if (!string.IsNullOrWhiteSpace(TierDisplay))
            {
                parts.Add(TierDisplay);
            }

            if (!string.IsNullOrWhiteSpace(EnchantDisplay))
            {
                parts.Add(EnchantDisplay);
            }

            return parts.Count == 0
                ? "No enchant context"
                : string.Join("  |  ", parts);
        }
    }
}
