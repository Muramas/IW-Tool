<Window x:Class="IdleWizard.BuildTool.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Idle Wizard Build Tool"
        Width="1700"
        Height="980"
        MinWidth="1280"
        MinHeight="760"
        Background="#171717"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFAFAF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

                <DataTemplate x:Key="SpellChipTemplate">
            <Border Background="#2F4058"
                    BorderBrush="#506A90"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,3"
                    Margin="2,2,4,4">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{Binding BadgeBrush}"
                            CornerRadius="7"
                            Padding="5,1"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding Badge}"
                                   Foreground="#111111"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="{Binding Name}"
                               Foreground="#F2F6FF"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EquipmentCardTemplate">
            <Border Background="#252525"
                    BorderBrush="#666666"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="{Binding Slot}"
                                   Foreground="#D8D8D8"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left"/>

                        <Border DockPanel.Dock="Right"
                                Background="{Binding VerdictBrush}"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock Text="{Binding Verdict}"
                                       Foreground="#111111"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding ItemDisplay}"
                               Foreground="#FFFFFF"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Border Background="#333333"
                                BorderBrush="#555555"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding TierDisplay}"
                                       Foreground="#E6E6E6"
                                       FontSize="12"/>
                        </Border>

                        <Border Background="#4A3B16"
                                BorderBrush="#B89C35"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3"
                                Margin="0,0,6,0">
                            <TextBlock Text="{Binding EnchantDisplay}"
                                       Foreground="#FFE699"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border Background="#1F3F2A"
                                BorderBrush="#63A86F"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3"
                                Visibility="{Binding HasScoreVisibility}">
                            <TextBlock Text="{Binding ScoreDisplay}"
                                       Foreground="#C6EFCE"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="{Binding Notes}"
                               Foreground="#BFBFBF"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="310"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="#242424"
                CornerRadius="8"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Scenario"
                           Foreground="#F2F2F2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                         x:Name="ScenarioPathTextBox"
                         Text=".\scenario_head_hero.json"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="Browse"
                        Margin="3"
                        Click="BrowseScenario_Click"/>

                <Button Grid.Column="3"
                        Content="Load"
                        Margin="3"
                        Click="LoadScenario_Click"/>

                <Button Grid.Column="4"
                        Content="Analyze"
                        Margin="3"
                        FontWeight="SemiBold"
                        Click="Analyze_Click"/>

                <Button Grid.Column="5"
                        Content="Open JSON"
                        Margin="3"
                        Click="OpenJson_Click"/>

                <TextBlock Grid.Column="6"
                           Text="WPF Cards v0.2"
                           Foreground="#F2F2F2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Main build layout -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Global panel -->
            <Border Grid.Column="0"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Character / Realm"
                                   Style="{StaticResource SectionTitle}"/>

                        
                        <!-- Save Import Panel -->
                        <Border Background="#263447"
                                BorderBrush="#4A668A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SaveImportHeader}"
                                           Foreground="#FFFFFF"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding SaveImportClassDisplay}"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           Margin="0,0,0,3"/>

                                <TextBlock Text="{Binding SaveImportPetDisplay}"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           Margin="0,0,0,3"/>

                                <TextBlock Text="{Binding SaveImportPetMaxDisplay}"
                                           Foreground="#CCCCCC"
                                           FontSize="12"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Equipment Presets"
                                           Foreground="#FFE699"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,4,0,4"/>

                                <ItemsControl ItemsSource="{Binding SaveImportPresetRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="#E6E6E6"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Spellbar"
                                           Foreground="#FFE699"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,10,0,4"/>

                                <ItemsControl ItemsSource="{Binding SaveImportSpellbarRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="#E6E6E6"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
<ItemsControl ItemsSource="{Binding GlobalRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Field}"
                                                   Style="{StaticResource SmallLabel}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   Style="{StaticResource ValueText}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Burst phase -->
            <Border Grid.Column="1"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Burst Phase"
                                   Style="{StaticResource SectionTitle}"/>

                        <Border Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding BurstPetDisplay}"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BurstPhaseWeightDisplay}"
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Spells"
                                   Foreground="#E6E6E6"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>

                        <ItemsControl ItemsSource="{Binding BurstSpells}"
                                      ItemTemplate="{StaticResource SpellChipTemplate}"
                                      Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Equipment"
                                   Foreground="#E6E6E6"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding BurstEquipmentCards}"
                                      ItemTemplate="{StaticResource EquipmentCardTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Void Mana phase -->
            <Border Grid.Column="2"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Void Mana Phase"
                                   Style="{StaticResource SectionTitle}"/>

                        <Border Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding VoidPetDisplay}"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding VoidPhaseWeightDisplay}"
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Spells"
                                   Foreground="#E6E6E6"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>

                        <ItemsControl ItemsSource="{Binding VoidSpells}"
                                      ItemTemplate="{StaticResource SpellChipTemplate}"
                                      Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Equipment"
                                   Foreground="#E6E6E6"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding VoidEquipmentCards}"
                                      ItemTemplate="{StaticResource EquipmentCardTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom results -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="95"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0"
                    Grid.Row="0"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ranked Recommendations"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"/>

                    <DataGrid Grid.Row="1"
                              x:Name="ResultsGrid"
                              ItemsSource="{Binding ResultRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="ResultsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width=".35*"/>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2.2*"/>
                            <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width=".45*"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding WeightedScore}" Width="1*"/>
                            <DataGridTextColumn Header="vs Equipped" Binding="{Binding VsEquipped}" Width="1*"/>
                            <DataGridTextColumn Header="Verified" Binding="{Binding Verified}" Width=".7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Grid.Row="0"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Selected Item Details"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"/>

                    <TextBox Grid.Row="1"
                             x:Name="DetailsTextBox"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"/>
                </Grid>
            </Border>

            <Border Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="1"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8">
                <TextBox x:Name="LogTextBox"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
            </Border>
        </Grid>
    </Grid>
</Window>


