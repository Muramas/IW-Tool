{
  "description": "Idle Wizard source/data files required by the build tool. Patterns are relative to the extracted/decompiled game root.",
  "logic_patterns": [
    "**/Assembly-CSharp/BigNumber.cs",
    "**/Assembly-CSharp/Variable*.cs",
    "**/Assembly-CSharp/ProfitVariable.cs",
    "**/Assembly-CSharp/NumberUtils.cs",
    "**/Assembly-CSharp/CritRatingCalculations.cs",
    "**/Assembly-CSharp/Effect*.cs",
    "**/Assembly-CSharp/*Effect.cs",
    "**/Assembly-CSharp/IEffect.cs",
    "**/Assembly-CSharp/SimpleEffect.cs",
    "**/Assembly-CSharp/CombineEffect.cs",
    "**/Assembly-CSharp/ActionEffect.cs",
    "**/Assembly-CSharp/GameContext.cs",
    "**/Assembly-CSharp/GameManager*.cs",
    "**/Assembly-CSharp/*GameManager*.cs",
    "**/Assembly-CSharp/Condition*.cs",
    "**/Assembly-CSharp/Resource*.cs",
    "**/Assembly-CSharp/*Names.cs",
    "**/Assembly-CSharp/*Keys.cs",
    "**/Assembly-CSharp/*Enums.cs",
    "**/Assembly-CSharp/Statistic*.cs",
    "**/Assembly-CSharp/Item*.cs",
    "**/Assembly-CSharp/Affix*.cs",
    "**/Assembly-CSharp/Upgrade*.cs",
    "**/Assembly-CSharp/Spell*.cs",
    "**/Assembly-CSharp/Scroll*.cs",
    "**/Assembly-CSharp/Orb*.cs",
    "**/Assembly-CSharp/Hero*.cs",
    "**/Assembly-CSharp/*Hero*.cs",
    "**/Assembly-CSharp/Pet*.cs",
    "**/Assembly-CSharp/*Pet*.cs",
    "**/Assembly-CSharp/Familiar*.cs",
    "**/Assembly-CSharp/*Familiar*.cs",
    "**/Assembly-CSharp/Building*.cs",
    "**/Assembly-CSharp/*Building*.cs",
    "**/Assembly-CSharp/Craft*.cs",
    "**/Assembly-CSharp/*Craft*.cs",
    "**/Assembly-CSharp/Save*.cs",
    "**/Assembly-CSharp/JsonLoader.cs",
    "**/Assembly-CSharp/GlobalData.cs",
    "**/Assembly-CSharp/*Manager.cs"
  ],
  "data_patterns": [
    "**/Resources/jsonfiles/*.bytes.txt",
    "**/Resources/jsonfiles/*.bytes",
    "**/Resources/jsonfiles/*.json",
    "**/Resources/translation/En.bytes.txt",
    "**/Resources/translation/En.bytes",
    "**/Resources/translation/*.bytes.txt",
    "**/Resources/translation/*.bytes"
  ],
  "ignore_patterns": [
    "**/System/**",
    "**/System.*/*",
    "**/mscorlib/**",
    "**/UnityEngine/**",
    "**/UnityEngine.*/*",
    "**/Newtonsoft.Json/**",
    "**/TextMeshPro/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.ogg",
    "**/*.wav"
  ]
}
