    private void OpenJson_Click(object sender, RoutedEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_lastResultPath) || !File.Exists(_lastResultPath))
        {
            MessageBox.Show(this, "No result JSON has been generated yet.", "No result");
            return;
        }

        Process.Start(new ProcessStartInfo
        {
            FileName = _lastResultPath,
            UseShellExecute = true
        });
    }

    private void LoadScenarioIntoSheets()
    {
        GlobalRows.Clear();
        BurstSpells.Clear();
        BurstEquipmentCards.Clear();
        VoidSpells.Clear();
        VoidEquipmentCards.Clear();

        var scenarioPath = ResolvePath(ScenarioPathTextBox.Text);

        if (!File.Exists(scenarioPath))
        {
            FillFallbackLayout();
            return;
        }

        try
        {
            using var doc = JsonDocument.Parse(File.ReadAllText(scenarioPath));
            var root = doc.RootElement;

            LoadItemNames(root, scenarioPath);

            FillGlobalRows(root);
            FillPhaseRows(root);
            LoadSpellValidationIfExists(scenarioPath);
            LoadPetValidationIfExists(scenarioPath);
            LoadSaveImportSummaryIfExists(scenarioPath);
            LoadPetValidationIfExists(scenarioPath);
            LoadSaveImportSummaryIfExists(scenarioPath);
            DataContext = null;
            DataContext = this;
        }
        catch (Exception ex)
        {
            AppendLog(ex.ToString());
            FillFallbackLayout();
        }
    }

    private void FillFallbackLayout()
    {
        AddSection(GlobalRows, "General");
        AddRow(GlobalRows, "Class", "");
        AddRow(GlobalRows, "Ascension", "");
        AddRow(GlobalRows, "Production Source", "");
        AddRow(GlobalRows, "Character Level", "");
        AddRow(GlobalRows, "Enchanting Dust", "");
        AddRow(GlobalRows, "Max Enchantment", "");

        // Burst phase fallback
        BurstPetDisplay = "Pet: not set";
        BurstSpells.Add(SpellChip.Placeholder("Spell not set"));
        BurstEquipmentCards.Add(new EquipmentCard { Slot = "Head", ItemDisplay = "No item selected", TierDisplay = "Tier -", EnchantDisplay = "Enchant -", Verdict = "Unset", VerdictBrush = "#CCCCCC", Notes = "" });

        // Void phase fallback
        VoidPetDisplay = "Pet: not set";
        VoidSpells.Add(SpellChip.Placeholder("Spell not set"));
        VoidEquipmentCards.Add(new EquipmentCard { Slot = "Head", ItemDisplay = "No item selected", TierDisplay = "Tier -", EnchantDisplay = "Enchant -", Verdict = "Unset", VerdictBrush = "#CCCCCC", Notes = "" });
    }

    private void FillGlobalRows(JsonElement root)
    {
        AddSection(GlobalRows, "General");

        if (root.TryGetProperty("globalContext", out var global)
            && global.ValueKind == JsonValueKind.Object)
        {
            AddKnownGlobal(global, "class", "Class");
            AddKnownGlobal(global, "ascension", "Ascension");
            AddKnownGlobal(global, "productionSource", "Production Source");
            AddKnownGlobal(global, "characterLevel", "Character Level");
            AddKnownGlobal(global, "maxPetLevel", "Maximum Pet Level");
            AddKnownGlobal(global, "legacy", "Legacy");
            AddKnownGlobal(global, "totalManaLog", "Total Mana log");
            AddKnownGlobal(global, "enchantingDust", "Enchanting Dust");
            AddKnownGlobal(global, "maxEnchantment", "Max Enchantment");
            AddKnownGlobal(global, "challengeEnchantBonusLevels", "Challenge Enchant Bonus");
        }
        else
        {
            AddRow(GlobalRows, "Class", "");
            AddRow(GlobalRows, "Ascension", "");
            AddRow(GlobalRows, "Production Source", "");
            AddRow(GlobalRows, "Character Level", "");
            AddRow(GlobalRows, "Enchanting Dust", "");
            AddRow(GlobalRows, "Max Enchantment", "");
        }

        AddSection(GlobalRows, "Objectives");

        if (root.TryGetProperty("objectives", out var objectives)
            && objectives.ValueKind == JsonValueKind.Object)
        {
            foreach (var objective in objectives.EnumerateObject())
            {
                AddRow(GlobalRows, objective.Name, GetJsonScalarAsString(objective.Value), "weight");
            }
        }

        AddSection(GlobalRows, "Current Values");

        if (root.TryGetProperty("currentValues", out var currentValues)
            && currentValues.ValueKind == JsonValueKind.Object)
        {
            foreach (var value in currentValues.EnumerateObject())
            {
                AddRow(GlobalRows, value.Name, GetJsonScalarAsString(value.Value));
            }
        }
    }

    private void AddKnownGlobal(JsonElement global, string jsonName, string label)
    {
        if (global.TryGetProperty(jsonName, out var value))
        {
            AddRow(GlobalRows, label, GetJsonScalarAsString(value));
        }
        else
        {
            AddRow(GlobalRows, label, "");
        }
    }

    private void FillPhaseRows(JsonElement root)
    {
        if (!root.TryGetProperty("phases", out var phases)
            || phases.ValueKind != JsonValueKind.Array)
        {
            // Burst phase fallback
            BurstPetDisplay = "Pet: not set";
            BurstSpells.Add(SpellChip.Placeholder("Spell not set"));
            BurstEquipmentCards.Add(new EquipmentCard { Slot = "Head", ItemDisplay = "No item selected", TierDisplay = "Tier -", EnchantDisplay = "Enchant -", Verdict = "Unset", VerdictBrush = "#CCCCCC", Notes = "" });

            // Void phase fallback
            VoidPetDisplay = "Pet: not set";
            VoidSpells.Add(SpellChip.Placeholder("Spell not set"));
            VoidEquipmentCards.Add(new EquipmentCard { Slot = "Head", ItemDisplay = "No item selected", TierDisplay = "Tier -", EnchantDisplay = "Enchant -", Verdict = "Unset", VerdictBrush = "#CCCCCC", Notes = "" });
            return;
        }

        var list = phases.EnumerateArray().ToList();

        var burst = list.FirstOrDefault(p =>
            GetString(p, "name").Contains("Burst", StringComparison.OrdinalIgnoreCase));

        var vm = list.FirstOrDefault(p =>
            GetString(p, "name").Contains("Void", StringComparison.OrdinalIgnoreCase)
            || GetString(p, "name").Contains("VM", StringComparison.OrdinalIgnoreCase));

        FillPhase(BurstSpells, BurstEquipmentCards, true, burst, "Burst Phase");
        FillPhase(VoidSpells, VoidEquipmentCards, false, vm, "Void Mana Phase");
    }

    private void FillPhase(
        ObservableCollection<SpellChip> spellsRows,
        ObservableCollection<EquipmentCard> equipmentCards,
        bool isBurst,
        JsonElement phase,
        string fallback)
    {
        var name = phase.ValueKind == JsonValueKind.Object
            ? GetString(phase, "name")
            : fallback;

        if (string.IsNullOrWhiteSpace(name))
        {
            name = fallback;
        }

        if (phase.ValueKind != JsonValueKind.Object)
        {
            if (isBurst)
            {
                BurstPetDisplay = "Pet: not set";
                BurstPhaseWeightDisplay = "Phase weight: not set";
            }
            else
            {
                VoidPetDisplay = "Pet: not set";
                VoidPhaseWeightDisplay = "Phase weight: not set";
            }

            spellsRows.Add(SpellChip.Placeholder("Spell not set"));
            equipmentCards.Add(new EquipmentCard
            {
                Slot = "Head",
                ItemDisplay = "No item selected",
                TierDisplay = "Tier -",
                EnchantDisplay = "Enchant -",
                Verdict = "Unset",
                VerdictBrush = "#CCCCCC",
                Notes = ""
            });

            return;
        }

        var pet = GetString(phase, "pet");
        var petLevel = GetString(phase, "petLevel");
        var phaseWeight = GetString(phase, "phaseWeight");

        if (isBurst)
        {
            BurstPetDisplay = string.IsNullOrWhiteSpace(pet)
                ? "Pet: not set"
                : $"Pet: {pet}  Lv {petLevel}";

            BurstPhaseWeightDisplay = $"Phase weight: {phaseWeight}";
        }
        else
        {
            VoidPetDisplay = string.IsNullOrWhiteSpace(pet)
                ? "Pet: not set"
                : $"Pet: {pet}  Lv {petLevel}";

            VoidPhaseWeightDisplay = $"Phase weight: {phaseWeight}";
        }

        if (phase.TryGetProperty("spells", out var spells)
            && spells.ValueKind == JsonValueKind.Array)
        {
            foreach (var spell in spells.EnumerateArray())
            {
                spellsRows.Add(new SpellChip { Name = GetJsonScalarAsString(spell), Badge = "?", BadgeBrush = "#CCCCCC" });
            }
        }

        if (spellsRows.Count == 0)
        {
            spellsRows.Add(SpellChip.Placeholder("No spells configured"));
        }

        if (phase.TryGetProperty("equipment", out var equipment)
            && equipment.ValueKind == JsonValueKind.Object)
        {
            foreach (var slot in equipment.EnumerateObject())
            {
                var item = slot.Value;

                var itemId = GetString(item, "itemId");
                var itemName = GetString(item, "itemName");
                var tier = GetString(item, "tier");
                var enchant = GetString(item, "enchantLevel");
                var bonus = GetString(item, "bonusEnchantLevel");

                var enchantDisplay = (!string.IsNullOrWhiteSpace(enchant) || !string.IsNullOrWhiteSpace(bonus))
                    ? $"Enchant {enchant}+{bonus}".Trim('+')
                    : "Enchant -";

                equipmentCards.Add(new EquipmentCard
                {
                    Slot = slot.Name,
                    ItemId = itemId,
                    Tier = tier,
                    ItemDisplay = string.IsNullOrWhiteSpace(itemId)
                        ? "No item selected"
                        : !string.IsNullOrWhiteSpace(itemName)
                            ? $"{itemName} (Item {itemId})"
                            : ResolveItemName(itemId),
                    TierDisplay = string.IsNullOrWhiteSpace(tier)
                        ? "Tier -"
                        : $"Tier {tier}",
                    EnchantDisplay = enchantDisplay,
                    Verdict = "Current",
                    VerdictBrush = "#FFE699",
                    ScoreDisplay = "",
                    Notes = "Current scenario equipment."
                });
            }
        }

        if (equipmentCards.Count == 0)
        {
            equipmentCards.Add(new EquipmentCard
            {
                Slot = "Head",
                ItemDisplay = "No item selected",
                TierDisplay = "Tier -",
                EnchantDisplay = "Enchant -",
                Verdict = "Unset",
                VerdictBrush = "#CCCCCC",
                Notes = ""
            });
        }
    }
    private async Task RunAnalysisAsync()
    {
        try
        {
            LogTextBox.Clear();
            ResultRows.Clear();
            DetailsTextBox.Clear();

            var scenarioPath = ResolvePath(ScenarioPathTextBox.Text);

            if (!File.Exists(scenarioPath))
            {
                MessageBox.Show(this, $"Scenario file not found:\n{scenarioPath}", "Missing scenario");
                return;
            }

            var resultPath = GetOutputJsonPathFromScenario(scenarioPath);
            _lastResultPath = resultPath;

            AppendLog($"Scenario: {scenarioPath}");
            AppendLog($"Expected result JSON: {resultPath}");
            AppendLog("");

            var repoRoot = FindRepoRoot();

            var cliProject = Path.Combine(
                repoRoot,
                "src",
                "IdleWizard.BuildTool.Cli",
                "IdleWizard.BuildTool.Cli.csproj"
            );

            if (!File.Exists(cliProject))
            {
                MessageBox.Show(this, $"CLI project not found:\n{cliProject}", "Missing CLI project");
                return;
            }

            var arguments =
                $"run --project \"{cliProject}\" -- --score-slot-weighted-file \"{scenarioPath}\"";

            AppendLog("Running:");
            AppendLog("dotnet " + arguments);
            AppendLog("");

            var output = await RunProcessAsync(repoRoot, "dotnet", arguments);

            AppendLog(output);

            var validationArguments =
                $"run --project \"{cliProject}\" -- --validate-phase-spells \"{scenarioPath}\"";

            AppendLog("");
            AppendLog("Running spell validation:");
            AppendLog("dotnet " + validationArguments);
            AppendLog("");

            var validationOutput = await RunProcessAsync(repoRoot, "dotnet", validationArguments);
            AppendLog(validationOutput);

            LoadSpellValidationIfExists(scenarioPath);
            var petValidationPath = GetPetValidationOutputPathFromScenario(scenarioPath);

            var petValidationArguments =
                "run --project \"" + cliProject + "\" -- --validate-phase-pets \"" + scenarioPath + "\" \"" + petValidationPath + "\"";

            AppendLog("");
            AppendLog("Running pet validation:");
            AppendLog("dotnet " + petValidationArguments);
            AppendLog("");

            var petValidationOutput = await RunProcessAsync(repoRoot, "dotnet", petValidationArguments);
            AppendLog(petValidationOutput);

            LoadPetValidationIfExists(scenarioPath);
            LoadSaveImportSummaryIfExists(scenarioPath);
            LoadPetValidationIfExists(scenarioPath);
            LoadSaveImportSummaryIfExists(scenarioPath);
            LoadPetValidationIfExists(scenarioPath);
            LoadSaveImportSummaryIfExists(scenarioPath);

            if (!File.Exists(resultPath))
            {
                MessageBox.Show(this, $"Result JSON was not created:\n{resultPath}", "Missing result");
                return;
            }

            LoadResultJson(resultPath);
        }
        catch (Exception ex)
        {
            MessageBox.Show(this, ex.ToString(), "Error");
        }
    }

    private void LoadResultJson(string resultPath)
    {
        ResultRows.Clear();
        DetailsTextBox.Clear();

        using var doc = JsonDocument.Parse(File.ReadAllText(resultPath));
        var root = doc.RootElement;

        if (!root.TryGetProperty("results", out var results)
            || results.ValueKind != JsonValueKind.Array)
        {
            MessageBox.Show(this, "Result JSON does not contain a results array.", "Invalid result");
            return;
        }

        CaptureBestRecommendation(root, results);

        foreach (var result in results.EnumerateArray())
        {
            ResultRows.Add(new ResultRow
            {
                Rank = GetString(result, "rank"),
                ItemId = GetString(result, "itemId"),
                Tier = GetString(result, "tier"),
                Name = GetString(result, "name"),
                WeightedScore = GetString(result, "weightedScore"),
                VsEquipped = GetString(result, "vsEquippedScoreDelta"),
                Verified = GetString(result, "fullyVerified"),
                RawJson = result.GetRawText()
            });
        }

        if (ResultRows.Count > 0)
        {
            ResultsGrid.SelectedIndex = 0;
        }

        ApplyRecommendationOverlay();

        AppendLog("");
        AppendLog($"Loaded result JSON: {resultPath}");
        AppendLog($"Rows: {ResultRows.Count}");
    }

    private void ResultsGrid_SelectionChanged(object sender, SelectionChangedEventArgs e)
    {
        if (ResultsGrid.SelectedItem is not ResultRow row)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(row.RawJson))
        {
            return;
        }

        using var doc = JsonDocument.Parse(row.RawJson);
        var element = doc.RootElement;

        var builder = new StringBuilder();

        builder.AppendLine($"{GetString(element, "name")} | Item {GetString(element, "itemId")} | Tier {GetString(element, "tier")}");
        builder.AppendLine($"Weighted Score: {GetString(element, "weightedScore")}");
        builder.AppendLine($"Vs Equipped:    {GetString(element, "vsEquippedScoreDelta")}");
        builder.AppendLine($"Verified:       {GetString(element, "fullyVerified")}");
        builder.AppendLine();

        if (element.TryGetProperty("objectiveContributions", out var contributions)
            && contributions.ValueKind == JsonValueKind.Object)
        {
            builder.AppendLine("Objective Contributions");
            builder.AppendLine("-----------------------");

            foreach (var objective in contributions.EnumerateObject())
            {
                var value = objective.Value;

                builder.AppendLine(objective.Name);
                builder.AppendLine($"  before:       {GetString(value, "before")}");
                builder.AppendLine($"  after:        {GetString(value, "after")}");
                builder.AppendLine($"  ratio:        {GetString(value, "ratio")}");
                builder.AppendLine($"  log10 ratio:  {GetString(value, "log10Ratio")}");
                builder.AppendLine($"  weight:       {GetString(value, "weight")}");
                builder.AppendLine($"  contribution: {GetString(value, "contribution")}");
                builder.AppendLine($"  direct:       {GetString(value, "directlyTouched")}");
                builder.AppendLine();
            }
        }

        if (element.TryGetProperty("changedResources", out var changedResources)
            && changedResources.ValueKind == JsonValueKind.Object)
        {
            builder.AppendLine("Changed Resources");
            builder.AppendLine("-----------------");

            foreach (var resource in changedResources.EnumerateObject())
            {
                var value = resource.Value;
                builder.AppendLine($"{resource.Name}: {GetString(value, "before")} -> {GetString(value, "after")}");
            }
        }

        DetailsTextBox.Text = builder.ToString();
    }

