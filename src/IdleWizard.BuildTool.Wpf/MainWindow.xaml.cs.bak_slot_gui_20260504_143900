    private void LoadItemNames(JsonElement scenarioRoot, string scenarioPath)
    {
        _itemNames.Clear();

        if (!scenarioRoot.TryGetProperty("workspace", out var workspaceElement))
        {
            return;
        }

        var workspaceRaw = GetJsonScalarAsString(workspaceElement);

        if (string.IsNullOrWhiteSpace(workspaceRaw))
        {
            return;
        }

        var workspace = ResolvePathRelativeToFile(scenarioPath, workspaceRaw);
        var rawRoot = Path.Combine(workspace, "raw_files");

        if (!Directory.Exists(rawRoot))
        {
            return;
        }

        var itemsFile = Directory
            .EnumerateFiles(rawRoot, "*", SearchOption.AllDirectories)
            .Where(path =>
                Path.GetFileName(path).Equals("Items.bytes", StringComparison.OrdinalIgnoreCase)
                || Path.GetFileName(path).Equals("Items.bytes.txt", StringComparison.OrdinalIgnoreCase)
                || Path.GetFileName(path).Equals("Items.json", StringComparison.OrdinalIgnoreCase)
            )
            .OrderBy(path => path)
            .FirstOrDefault();

        if (itemsFile is null)
        {
            return;
        }

        try
        {
            using var doc = JsonDocument.Parse(File.ReadAllText(itemsFile));

            if (doc.RootElement.ValueKind != JsonValueKind.Array)
            {
                return;
            }

            foreach (var item in doc.RootElement.EnumerateArray())
            {
                var id = GetString(item, "ID");
                var name = GetString(item, "Name");

                if (!string.IsNullOrWhiteSpace(id)
                    && !string.IsNullOrWhiteSpace(name))
                {
                    _itemNames[id] = name;
                }
            }
        }
        catch
        {
            // Non-fatal. UI can still show item IDs.
        }
    }

    private string ResolveItemName(string itemId)
    {
        if (_itemNames.TryGetValue(itemId, out var name))
        {
            return $"{name} (Item {itemId})";
        }

        return $"Item {itemId}";
    }

    private void CaptureBestRecommendation(JsonElement resultRoot, JsonElement results)
    {
        _lastScoredSlot = null;
        _bestItemId = null;
        _bestTier = null;
        _bestName = null;
        _bestScoreDelta = null;

        if (resultRoot.TryGetProperty("slot", out var slotElement))
        {
            _lastScoredSlot = GetJsonScalarAsString(slotElement);
        }

        if (results.ValueKind != JsonValueKind.Array)
        {
            return;
        }

        var first = results.EnumerateArray().FirstOrDefault();

        if (first.ValueKind != JsonValueKind.Object)
        {
            return;
        }

        _bestItemId = GetString(first, "itemId");
        _bestTier = GetString(first, "tier");
        _bestName = GetString(first, "name");
        _bestScoreDelta = GetString(first, "vsEquippedScoreDelta");
    }

    private void ApplyRecommendationOverlay()
    {
        if (string.IsNullOrWhiteSpace(_lastScoredSlot)
            || string.IsNullOrWhiteSpace(_bestItemId))
        {
            MarkRecommendationsPending(BurstEquipmentCards);
            MarkRecommendationsPending(VoidEquipmentCards);

            DataContext = null;
            DataContext = this;

            return;
        }

        ApplyRecommendationOverlay(BurstEquipmentCards);
        ApplyRecommendationOverlay(VoidEquipmentCards);

        DataContext = null;
        DataContext = this;
    }

    private static void MarkRecommendationsPending(ObservableCollection<EquipmentCard> cards)
    {
        foreach (var card in cards)
        {
            card.SuggestedStatus = "Pending";
            card.SuggestedStatusBrush = "#CCCCCC";
            card.SuggestedItemDisplay = "Run Analyze to get a suggestion.";
            card.SuggestedRankDisplay = "";
            card.SuggestedGainDisplay = "";
            card.SuggestedReason = "No recommendation has been calculated for this slot yet.";

            if (string.IsNullOrWhiteSpace(card.ScoreDisplay))
            {
                card.ScoreDisplay = "";
            }

            if (string.IsNullOrWhiteSpace(card.Notes))
            {
                card.Notes = card.SuggestedReason;
            }
        }
    }

    private void ApplyRecommendationOverlay(ObservableCollection<EquipmentCard> cards)
    {
        foreach (var card in cards)
        {
            if (!card.Slot.Equals(_lastScoredSlot, StringComparison.OrdinalIgnoreCase))
            {
                card.SuggestedStatus = "Not scored";
                card.SuggestedStatusBrush = "#999999";
                card.SuggestedItemDisplay = "No suggestion for this slot from the latest analysis.";
                card.SuggestedRankDisplay = "";
                card.SuggestedGainDisplay = "";
                card.SuggestedReason = "The latest analysis targeted " + _lastScoredSlot + ", not " + card.SlotDisplay + ".";

                // Preserve legacy display fields for old XAML/popup bindings.
                if (string.IsNullOrWhiteSpace(card.ScoreDisplay))
                {
                    card.ScoreDisplay = "";
                }

                card.Notes = card.SuggestedReason;

                continue;
            }

            var bestName = string.IsNullOrWhiteSpace(_bestName)
                ? "Unknown suggested item"
                : _bestName;

            var bestItemDisplay =
                bestName +
                " (Item " + (_bestItemId ?? "?") +
                ", Tier " + (_bestTier ?? "?") + ")";

            var isCurrentBest =
                card.ItemId.Equals(_bestItemId ?? "", StringComparison.OrdinalIgnoreCase)
                && card.Tier.Equals(_bestTier ?? "", StringComparison.OrdinalIgnoreCase);

            if (isCurrentBest)
            {
                card.Verdict = "Best";
                card.VerdictBrush = "#C6EFCE";

                card.SuggestedStatus = "Best";
                card.SuggestedStatusBrush = "#C6EFCE";
                card.SuggestedItemDisplay = card.ItemDisplay;
                card.SuggestedRankDisplay = "Rank #1";
                card.SuggestedGainDisplay = "Current item already matches the top recommendation.";
                card.SuggestedReason =
                    "This equipped item is already the best known recommendation for " +
                    card.SlotDisplay +
                    " under the current objective weights and enchant assumptions: " +
                    card.CurrentEnchantContext +
                    ".";

                // Legacy fields.
                card.ScoreDisplay = card.SuggestedGainDisplay;
                card.Notes = card.SuggestedReason;
            }
            else
            {
                card.Verdict = "Review";
                card.VerdictBrush = "#FFF2CC";

                card.SuggestedStatus = "Review";
                card.SuggestedStatusBrush = "#FFF2CC";
                card.SuggestedItemDisplay = bestItemDisplay;
                card.SuggestedRankDisplay = "Rank #1";
                card.SuggestedGainDisplay = string.IsNullOrWhiteSpace(_bestScoreDelta)
                    ? "Estimated score delta unavailable."
                    : "Estimated score delta: " + _bestScoreDelta;

                card.SuggestedReason =
                    "Suggested for " + card.SlotDisplay + ": " + bestItemDisplay + "." + Environment.NewLine +
                    "Compared against current item: " + card.ItemDisplay + "." + Environment.NewLine +
                    "Current enchant context: " + card.CurrentEnchantContext + "." + Environment.NewLine +
                    "This recommendation is based on the latest scored objective weights. " +
                    "A different enchant setup may change the best item.";

                // Legacy fields.
                card.ScoreDisplay = card.SuggestedGainDisplay;
                card.Notes = card.SuggestedReason;
            }

            // Keep old badge useful until XAML fully moves to the new Suggested* fields.
            card.RecommendationBadge = card.SuggestedStatus;
        }
    }
    private static async Task<string> RunProcessAsync(string workingDirectory, string fileName, string arguments)
    {
        var startInfo = new ProcessStartInfo
        {
            FileName = fileName,
            Arguments = arguments,
            WorkingDirectory = workingDirectory,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false,
            CreateNoWindow = true
        };

        var process = new Process
        {
            StartInfo = startInfo
        };

        var output = new StringBuilder();

        process.OutputDataReceived += (_, e) =>
        {
            if (e.Data is not null)
            {
                output.AppendLine(e.Data);
            }
        };

        process.ErrorDataReceived += (_, e) =>
        {
            if (e.Data is not null)
            {
                output.AppendLine(e.Data);
            }
        };

        process.Start();
        process.BeginOutputReadLine();
        process.BeginErrorReadLine();

        await process.WaitForExitAsync();

        output.AppendLine($"Process exit code: {process.ExitCode}");

        return output.ToString();
    }

    private static string FindRepoRoot()
    {
        var current = AppContext.BaseDirectory;

        while (!string.IsNullOrWhiteSpace(current))
        {
            var candidate = Path.Combine(
                current,
                "src",
                "IdleWizard.BuildTool.Cli",
                "IdleWizard.BuildTool.Cli.csproj"
            );

            if (File.Exists(candidate))
            {
                return current;
            }

            var parent = Directory.GetParent(current);

            if (parent is null)
            {
                break;
            }

            current = parent.FullName;
        }

        var localCandidate = Path.Combine(
            Environment.CurrentDirectory,
            "src",
            "IdleWizard.BuildTool.Cli",
            "IdleWizard.BuildTool.Cli.csproj"
        );

        if (File.Exists(localCandidate))
        {
            return Environment.CurrentDirectory;
        }

        throw new DirectoryNotFoundException(
            "Could not locate repository root containing src\\IdleWizard.BuildTool.Cli\\IdleWizard.BuildTool.Cli.csproj"
        );
    }

    private static string GetOutputJsonPathFromScenario(string scenarioPath)
    {
        using var doc = JsonDocument.Parse(File.ReadAllText(scenarioPath));
        var root = doc.RootElement;

        if (root.TryGetProperty("outputJson", out var outputJson)
            && outputJson.ValueKind == JsonValueKind.String)
        {
            var raw = outputJson.GetString();

            if (!string.IsNullOrWhiteSpace(raw))
            {
                return ResolvePathRelativeToFile(scenarioPath, raw);
            }
        }

        return Path.Combine(
            Path.GetDirectoryName(scenarioPath) ?? Environment.CurrentDirectory,
            "results.json"
        );
    }

    private static string ResolvePath(string path)
    {
        if (Path.IsPathRooted(path))
        {
            return path;
        }

        return Path.GetFullPath(path);
    }

    private static string ResolvePathRelativeToFile(string baseFile, string path)
    {
        if (Path.IsPathRooted(path))
        {
            return path;
        }

        var directory = Path.GetDirectoryName(Path.GetFullPath(baseFile))
            ?? Environment.CurrentDirectory;

        return Path.GetFullPath(Path.Combine(directory, path));
    }

    private static string GetString(JsonElement element, string propertyName)
    {
        if (!element.TryGetProperty(propertyName, out var value))
        {
            return "";
        }

        return GetJsonScalarAsString(value);
    }

    private static string GetJsonScalarAsString(JsonElement element)
    {
        return element.ValueKind switch
        {
            JsonValueKind.String => element.GetString() ?? "",
            JsonValueKind.Number => element.GetRawText(),
            JsonValueKind.True => "true",
            JsonValueKind.False => "false",
            JsonValueKind.Null => "",
            _ => element.GetRawText()
        };
    }

    private void AppendLog(string text)
    {
        LogTextBox.AppendText(text + Environment.NewLine);
    }
