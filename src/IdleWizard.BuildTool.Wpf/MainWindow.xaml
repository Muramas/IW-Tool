<Window x:Class="IdleWizard.BuildTool.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Idle Wizard Build Tool"
        Width="1500"
        Height="950"
        MinWidth="1200"
        MinHeight="760"
        Background="#151515"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <DataTemplate x:Key="SpellChipTemplate">
            <Border Background="#2F4058"
                    BorderBrush="#506A90"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,5"
                    Margin="2,2,5,5">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               Foreground="#F2F6FF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Badge}"
                               Foreground="#FFE699"
                               FontSize="10"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

                        <DataTemplate x:Key="EquipmentCardTemplate">
            <Border Background="#252525"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,8">
                        <TextBlock Text="{Binding SlotDisplay}"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   DockPanel.Dock="Left"/>

                        <Border Background="{Binding SuggestedStatusBrush}"
                                CornerRadius="7"
                                Padding="7,2"
                                DockPanel.Dock="Right">
                            <TextBlock Text="{Binding SuggestedStatus}"
                                       Foreground="#111111"
                                       FontWeight="SemiBold"
                                       FontSize="10"/>
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#1E1E1E"
                                BorderBrush="#3D3D3D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9">
                            <StackPanel>
                                <TextBlock Text="Current"
                                           Foreground="#AAAAAA"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding ItemDisplay}"
                                           Foreground="#F2F2F2"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding CurrentEnchantContext}"
                                           Foreground="#CCCCCC"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#202838"
                                BorderBrush="#506A90"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9"
                                Cursor="Hand"
                                MouseLeftButtonUp="SuggestedRecommendation_Click"
                                ToolTip="Click to view recommendations for this slot">
                            <StackPanel>
                                <TextBlock Text="Suggested"
                                           Foreground="#AAAAAA"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>

                                <TextBlock Text="{Binding SuggestedItemDisplay}"
                                           Foreground="#FFFFFF"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding SuggestedRankDisplay}"
                                           Foreground="#FFE699"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="{Binding SuggestedGainDisplay}"
                                           Foreground="#E6E6E6"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4"/>

                                <TextBlock Text="{Binding SuggestedReason}"
                                           Foreground="#CFCFCF"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           MaxHeight="44"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0"
                Background="#202020"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Scenario"
                           Foreground="#F2F2F2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                         x:Name="ScenarioPathTextBox"
                         Text=".\scenario_head_hero.json"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="Browse"
                        Margin="3"
                        Click="BrowseScenario_Click"/>

                <Button Grid.Column="3"
                        Content="Load"
                        Margin="3"
                        Click="LoadScenario_Click"/>

                <Button Grid.Column="4"
                        Content="Import Save"
                        Margin="3"
                        FontWeight="SemiBold"
                        Click="ImportSave_Click"/>

                <Button Grid.Column="5"
                        Content="Analyze"
                        Margin="3"
                        FontWeight="SemiBold"
                        Click="Analyze_Click"/>

                <Button Grid.Column="6"
                        Content="Open JSON"
                        Margin="3"
                        Click="OpenJson_Click"/>

                <Button Grid.Column="7"
                        Content="Log"
                        Margin="3"
                        Click="Log_Click"/>

                <TextBlock Grid.Column="8"
                           Text="WPF Cards v0.2"
                           Foreground="#F2F2F2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Character / Realm -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}"
                    Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Character / Realm"
                                   Style="{StaticResource SectionTitle}"/>

                        <ItemsControl ItemsSource="{Binding GlobalRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="1.25*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Field}"
                                                   Style="{StaticResource SmallLabel}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Burst phase -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardBorder}"
                    Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Burst Phase"
                                   Style="{StaticResource SectionTitle}"/>

                        <Border Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding BurstPetDisplay}"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding BurstPhaseWeightDisplay}"
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Spells"
                                   Style="{StaticResource SubTitle}"/>

                        <ItemsControl ItemsSource="{Binding BurstSpells}"
                                      ItemTemplate="{StaticResource SpellChipTemplate}"
                                      Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Equipment"
                                   Style="{StaticResource SubTitle}"/>

                        <ItemsControl ItemsSource="{Binding BurstEquipmentCards}"
                                      ItemTemplate="{StaticResource EquipmentCardTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Void Mana phase -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Void Mana Phase"
                                   Style="{StaticResource SectionTitle}"/>

                        <Border Background="#2A2A2A"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding VoidPetDisplay}"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="{Binding VoidPhaseWeightDisplay}"
                                           Foreground="#AAAAAA"
                                           FontSize="12"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Spells"
                                   Style="{StaticResource SubTitle}"/>

                        <ItemsControl ItemsSource="{Binding VoidSpells}"
                                      ItemTemplate="{StaticResource SpellChipTemplate}"
                                      Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Equipment"
                                   Style="{StaticResource SubTitle}"/>

                        <ItemsControl ItemsSource="{Binding VoidEquipmentCards}"
                                      ItemTemplate="{StaticResource EquipmentCardTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Hidden compatibility controls for code-behind -->
        <Grid Grid.Row="2"
              Height="0"
              Visibility="Collapsed">
            <DataGrid x:Name="ResultsGrid"
                      ItemsSource="{Binding RankedRecommendationRows}"
                      AutoGenerateColumns="True"/>

            <TextBox x:Name="LogTextBox"
                     Visibility="Collapsed"/>

            <TextBox x:Name="DetailsTextBox"
                     Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>





